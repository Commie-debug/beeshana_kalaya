@party
on-arrival: {!
Q.left_strength_pct = Q.left_strength / 60 * 100;
Q.nationalist_strength_pct = Q.nationalist_strength / 60 * 100;
Q.left_dissent_pct = Q.left_dissent / 50 * 100;
Q.nationalist_dissent_pct = Q.nationalist_dissent / 50 * 100;

Q.sirimavo_split_pct = (Q.split_sirimavo_victory / 3) * 100;
Q.maitripala_split_pct = (Q.split_maitripala_victory / 3) * 100;
!}

{!<img src="img/SLFP_Banner.png" style="width: 94%; height: auto; border: 4px solid #1919a9; padding: 4px; background-color: var(--content-bg-color); box-shadow: inset 2px 2px 6px rgba(0,0,0,0.3);">!}

[? if the_split = 1 : 
{!
<div style="text-align: center; margin-bottom: 15px; margin-top: 10px; padding: 10px; background: var(--content-bg-color);">
  <div style="font-weight: bold; font-size: 1.2em; margin-bottom: 8px;">Disputed Party Leadership</div>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
    <div style="text-align: left;">
      <span class="mytooltip no-highlight" style="cursor: help;">
        <img src="img/sirimavo_fight.svg" style="width: 40px; height: 40px; vertical-align: middle;" />
        <span class="mytooltiptext" style="font-weight: bold;"><img src="img/sirimavo_fight.svg"/>Sirimavo Bandaranaike (Left)</span>
      </span>
    </div>
    <div style="text-align: right;">
      <span class="mytooltip no-highlight" style="cursor: help;">
        <img src="img/maitripala_fight.svg" style="width: 40px; height: 40px; vertical-align: middle;" />
        <span class="mytooltiptext" style="font-weight: bold; "><img src="img/maitripala_fight.svg"/>Maithripala Senanayake (Nationalists)</span>
      </span>
    </div>
  </div>
  <div style="height: 14px; background: var(--content-bg-color); border-radius: 7px; overflow: hidden; border: 1px solid #011c57; display: flex; width: 100%;">
    <div style="background: #A91101; height: 100%; width: !}[+ sirimavo_split_pct +]{!%; transition: width 0.4s;"></div>
    <div style="background: transparent; height: 100%; flex-grow: 1;"></div>
    <div style="background: #0F52BA; height: 100%; width: !}[+ maitripala_split_pct +]{!%; transition: width 0.4s;"></div>
  </div>
</div>
!}
?]

