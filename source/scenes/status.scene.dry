@paramilitaries
on-arrival: {!
if (Q.slfpt_strength) {
    Q.slfpt_strength_2 = Q.slfpt_strength.toFixed(1);
}
if (Q.jss_strength) {
    Q.jss_strength_2 = Q.jss_strength.toFixed(1);
}
if (Q.ltte_strength) {
    Q.ltte_strength_2 = Q.ltte_strength.toFixed(1);
}
if (Q.telo_strength) {
    Q.telo_strength_2 = Q.telo_strength.toFixed(1);
}
if (Q.eros_strength) {
    Q.eros_strength_2 = Q.eros_strength.toFixed(1);
}
if (Q.plote_strength) {
    Q.plote_strength_2 = Q.plote_strength.toFixed(1);
}
if (Q.eprlf_strength) {
    Q.eprlf_strength_2 = Q.eprlf_strength.toFixed(1);
}
if (Q.prra_strength) {
    Q.prra_strength_2 = Q.prra_strength.toFixed(1);
}
if (Q.djv_strength) {
    Q.djv_strength_2 = Q.djv_strength.toFixed(1);
}
if (Q.eagles_strength) {
    Q.eagles_strength_2 = Q.eagles_strength.toFixed(1);
}
if (Q.epdp_strength) {
    Q.epdp_strength_2 = Q.epdp_strength.toFixed(1);
}
if (Q.tna_strength) {
    Q.tna_strength_2 = Q.tna_strength.toFixed(1);
}
if (Q.endlf_strength) {
    Q.endlf_strength_2 = Q.endlf_strength.toFixed(1);
}
if (Q.blackcats_strength) {
    Q.blackcats_strength_2 = Q.blackcats_strength.toFixed(1);
}
if (Q.ipkf_morale) {
    Q.ipkf_morale_2 = Q.ipkf_morale.toFixed(1);
}

const getTip = id => {
    let t = tooltipList.find(x => x.searchString === id);
    let tipContent = t ? window.getDynamicTooltipContent(id, t) : '';
    
    return tipContent
        .replace(/Tamil Eelam/g, 'Tamil<span></span> Eelam')
        .replace(/Sri Lanka Army/g, 'Sri Lanka A&zwnj;rmy')
        .replace(/Sri Lanka Navy/g, 'Sri Lanka N&zwnj;avy')
        .replace(/Sri Lanka AirForce/g, 'Sri Lanka A&zwnj;irForce')
        .replace(/Sri Lanka Police/g, 'Sri Lanka P&zwnj;olice')
        .replace(/Special Task Force/g, 'Special T&zwnj;ask Force')
        .replace(/Black Cats/g, 'B&zwnj;lack Cats')
        .replace(/STF/g, 'S&zwnj;TF')
        .replace(/NIB/g, 'N&zwnj;IB')
        .replace(/Home Guard/g, 'Home G&zwnj;uard')
        .replace(/Civil Security/g, 'Civil S&zwnj;ecurity')
        .replace(/IPKF/g, 'I&zwnj;PKF')
        .replace(/EPDP/g, 'E&zwnj;PDP')
        .replace(/TNA/g, 'T&zwnj;NA')
        .replace(/JVP Thugs/g, 'J&zwnj;VP Thugs')
        .replace(/ENDLF/g, 'E&zwnj;NDLF');
        
};

Q.tip_ltte = getTip('LTTE');
Q.tip_plote = getTip('PLOTE');
Q.tip_eprlf = getTip('EPRLF');
Q.tip_eros = getTip('EROS');
Q.tip_telo = getTip('TELO');
Q.tip_army = getTip('Sri Lanka Army');
Q.tip_navy = getTip('Sri Lanka Navy');
Q.tip_air = getTip('Sri Lanka AirForce');
Q.tip_police = getTip('Sri Lanka Police');
Q.tip_stf = getTip('STF');
Q.tip_nib = getTip('NIB');
Q.tip_hg = getTip('Home Guard');
Q.tip_cs = getTip('Civil Security');
Q.tip_ipkf = getTip('IPKF');
Q.tip_epdp = getTip('EPDP');
Q.tip_tna = getTip('TNA');
Q.tip_endlf = getTip('ENDLF');
Q.tip_slfpt = getTip('SLFP');
Q.tip_prra = getTip('PRRA');
Q.tip_jss = getTip('JSS');
Q.tip_jvpt = getTip('JVP');
Q.tip_djv = getTip('DJV');
Q.tip_blackcats = getTip('Black Cats');
Q.tip_eagles = getTip('Eagles Of The Central Hills');
!}

= Political Paramilitaries

{!<img src="img/paramilitaries.jpg" style="width: 85%; height: auto; border: 4px solid rgb(43, 43, 43); padding: 4px; background-color: var(--content-bg-color); box-shadow: inset 2px 2px 6px rgba(0,0,0,0.3); display: block; margin: 0 auto;">!}

<div style="position: relative; width: 85%; display: block; margin: 25px auto 40px auto;">
<img src="img/streets.svg" style="width: 100%; display: block; height: auto;" />

<div style="position: absolute; top: 4%; left: 0; width: 100%; text-align: center; font-family: 'Stick No Bills', sans-serif; font-size: 1.1em; font-weight: bold; z-index: 10;">
  <span class="mytooltip no-highlight" style="cursor: help;">
    <img src="img/para_fighting_logo.svg" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 6px;" />[+ parafighting : control +]
    <span class="mytooltiptext"><img src="img/para_fighting_logo.svg"/>Intensity of street violence and paramilitary clashes<br>[+ parafighting : control +]</span>
  </span>
</div>

[? if prra_formed = 1 :
<div class="mytooltip no-highlight" style="position: absolute; left: 4%; top: 46%; width: 25%; cursor: help; text-align: center;">
