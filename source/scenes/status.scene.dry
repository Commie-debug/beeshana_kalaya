<div style="font-family: 'Stick No Bills', sans-serif; font-size: 0.85em; line-height: 1.2; text-align: center; margin-top: 5px;"><img src="img/militant_strenght_logo.svg" style="width: 14px; height: 14px; vertical-align: middle; margin-right: 4px;" />Str: [+ telo_strength : group_strength +]<br><img src="img/militant_militancy_logo.svg" style="width: 14px; height: 14px; vertical-align: middle; margin-right: 4px;" />[+ telo_militancy : militancy +]</div>
