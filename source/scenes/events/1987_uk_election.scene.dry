title: UK General Elections
new-page: true
max-visits: 1
tags: event
view-if: year = 1987 and month = 6 and week = 1
on-arrival: {!
    // 1. Set the visual style (British mode uses circles, Saskatchewan mode uses paired desks)
    Q.brit_mode = true; 
    Q.house_width = 10;
    Q.parties = ['tory', 'labour', 'liberaluk','sdp','uup','snp','sdlp','plaid','dup','sinnfein','upup'];

    //government party 
    Q.tory_seats = 376;
    Q.tory_in_government = 1;

    //opposition parties
    Q.labour_seats = 229;
    Q.labour_in_government = 0;
    Q.liberaluk_seats = 17;
    Q.liberaluk_in_government = 0;
    Q.sdp_seats = 5;
    Q.sdp_in_government = 0;
    Q.snp_seats = 3;
    Q.snp_in_government = 0;
    Q.uup_seats = 9;
    Q.uup_in_government = 0;
    Q.dup_seats = 3;
    Q.dup_in_government = 0;
    Q.plaid_seats = 3;
    Q.plaid_in_government = 0;
    Q.sdlp_seats = 3;
    Q.sdlp_in_government = 0;
    Q.sinnfein_seats = 1;
    Q.sinnfein_in_government = 0;
    Q.upup_seats = 1;
    Q.upup_in_government = 0;
!}
on-display: {!
    window.showSceneImage('img/logos/UK_Logo.png'); 
    setTimeout(function() {
        window.westminster('uk_parliament_svg', false);
    }, 100);
!}

