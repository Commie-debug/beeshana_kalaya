title: Tamil rebel attack
subtitle: The tamil rebels have launched another attack
view-if: rebel_attack_events = 1
tags: event
priority: 3
on-arrival: {!
    // 1. Immediately turn off the trigger so it doesn't loop
    Q.attack_random_events = 0;
    
    // 2. Build the array of valid attackers
    var valid_attacks = ['unp_attack'];
    if (Q.slmc_formed == 1 && Q.slmc_relation < 14.9) {
        valid_attacks.push('slmc_attack');
    }
    
    // 3. Select the attacker
    var randomIndex = Math.floor(Math.random() * valid_attacks.length);
    Q.selected_attack = valid_attacks[randomIndex];
!}
go-to: unp_attack if selected_attack == "unp_attack"; slmc_attack if selected_attack == "slmc_attack"