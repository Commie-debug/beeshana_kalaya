<div class="mytooltip no-highlight" style="width: 48%; box-sizing: border-box; padding: 8px; margin-bottom: 10px; display: flex; align-items: center; cursor: help;">
<img src="img/logos/TNA_Logo.png" style="width: 45px; height: 45px; object-fit: contain; margin-right: 10px; flex-shrink: 0;" />
<div style="line-height: 1.3; font-size: 0.9em;"><img src="img/para_strenght_logo.svg" style="width: 14px; height: 14px; vertical-align: middle; margin-right: 4px;" />Str: [+ tna_strength_2 : group_strength +]<br><img src="img/para_militancy_logo.svg" style="width: 14px; height: 14px; vertical-align: middle; margin-right: 4px;" />[+ tna_militancy : militancy +]</div>
<span class="mytooltiptext">[+ tip_tna +]</span>
</div>
?]
[? if endlf_formed = 1 :
<div class="mytooltip no-highlight" style="width: 48%; box-sizing: border-box; padding: 8px; margin-bottom: 10px; display: flex; align-items: center; cursor: help;">
<img src="img/logos/ENDLF_Logo.png" style="width: 45px; height: 45px; object-fit: contain; margin-right: 10px; flex-shrink: 0;" />
<div style="line-height: 1.3; font-size: 0.9em;"><img src="img/para_strenght_logo.svg" style="width: 14px; height: 14px; vertical-align: middle; margin-right: 4px;" />Str: [+ endlf_strength_2 : group_strength +]<br><img src="img/para_militancy_logo.svg" style="width: 14px; height: 14px; vertical-align: middle; margin-right: 4px;" />[+ endlf_militancy : militancy +]</div>
<span class="mytooltiptext">[+ tip_endlf +]</span>
</div>
?]
</div>

@polls
on-arrival: {!
Q.sinhala_nationalism_disp = Math.round(Q.sinhala_nationalism);
Q.tamil_nationalism_disp = Math.round(Q.tamil_nationalism);
Q.gov_support_disp = Math.round(Q.gov_support);

!}

