<img src="img/situation_logo.svg" style="width: 35px; height: 35px; object-fit: contain; margin-right: 10px; flex-shrink: 0;" />
<div style="font-size: 0.9em; line-height: 1.2;">Current Situation:<br>[+ tamil_war : war +]</div>
</div>
<div style="display: flex; align-items: center; width: 48%; margin-bottom: 15px;">
<img src="img/radicalisation_logo.svg" style="width: 35px; height: 35px; object-fit: contain; margin-right: 10px; flex-shrink: 0;" />
<div style="font-size: 0.9em; line-height: 1.2;">Radicalisation:<br>[+ tamil_radicalisation : radicalism +]</div>
</div>
<div style="display: flex; align-items: center; width: 48%; margin-bottom: 15px;">
<img src="img/militant_morale_logo.svg" style="width: 35px; height: 35px; object-fit: contain; margin-right: 10px; flex-shrink: 0;" />
<div style="font-size: 0.9em; line-height: 1.2;">Militant Morale:<br>[+ tamil_morale : loyalty +]</div>
</div>
<div style="display: flex; align-items: center; width: 48%; margin-bottom: 15px;">
<img src="img/ne_control_logo.svg" style="width: 35px; height: 35px; object-fit: contain; margin-right: 10px; flex-shrink: 0;" />
<div style="font-size: 0.9em; line-height: 1.2;">North-East Control:<br>[+ militant_control : radicalism +]</div>
</div>
<div style="display: flex; align-items: center; width: 100%; justify-content: center; margin-top: 5px;">
<img src="img/jaffna_control_logo.svg" style="width: 35px; height: 35px; object-fit: contain; margin-right: 10px; flex-shrink: 0;" />
<div style="font-size: 0.95em; line-height: 1.2;"><span class="wide_tooltip-wrap">Jaffna<span class="wide_tooltip-tip"><img src="img/Nallur_Kandaswamy.jpg">Second largest city in Sri Lanka and the largest in the Tamil north-east. Its large population and importance historically and culturally have made it a hub of militant activity.</span></span> Control:<br>[+ jaffna_control +]</div>
</div>
</div>

= Military & State Paramilitaries

{!<img src="img/military.jpg" style="width: 94%; height: auto; border: 4px solid rgb(43, 43, 43); padding: 4px; background-color: var(--content-bg-color); box-shadow: inset 2px 2px 6px rgba(0,0,0,0.3); display: block; margin: 0 auto 1.5em auto;">!}

