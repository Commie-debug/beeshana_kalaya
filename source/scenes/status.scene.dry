title: Status
new-page: true
is-special: true
on-arrival: {!
    var _newData = [];
    function _addP(id, legend, seats) {
        if (seats && seats > 0) _newData.push({ id: id, legend: legend, name: legend, seats: seats });
    }
    _addP('slfp', 'SLFP', Q.slfp_r);
    _addP('slpp', 'SLPP', Q.slpp_r);
    _addP('slmp', 'SLMP', Q.slmp_r);
    _addP('unp',  'UNP',  Q.unp_r);
    _addP('tulf', 'TULF', Q.tulf_r);
    _addP('pflt', 'PFLT', Q.pflt_r);
    _addP('actc', 'ACTC', Q.actc_r);
    _addP('eros', 'EROS', Q.eros_r);
    _addP('dplf', 'DPLF', Q.dplf_r);
    _addP('eprlf','EPRLF',Q.eprlf_r);
    _addP('telo', 'TELO', Q.telo_r);
    _addP('endlf','ENDLF',Q.endlf_r);
    _addP('jvp',  'JVP',  Q.jvp_r);
    _addP('npp',  'NPP',  Q.npp_r);
    _addP('cpsl', 'CPSL', Q.cpsl_r);
    _addP('lssp', 'LSSP', Q.lssp_r);
    _addP('nssp', 'NSSP', Q.nssp_r);
    _addP('mep',  'MEP',  Q.mep_r);
    _addP('dunf', 'DUNF', Q.dunf_r);
    _addP('ulpp', 'ULPP', Q.ulpp_r);
    _addP('cwc',  'CWC',  Q.cwc_r);
    _addP('ucpf', 'UCPF', Q.ucpf_r);
    _addP('slmc', 'SLMC', Q.slmc_r);

    var _newSig = JSON.stringify(_newData.map(function(p){ return p.id + p.seats; }));
    var _changed = (_newSig !== window._parliSig);
    window._parliData = _newData;
    if (_changed) {
        window._parliSig = _newSig;
        window._parliAnimate = true;
    } else {
        window._parliAnimate = false;
    }
!}

= Status

<img src="[+ current_bg +]" style="width: 94%; height: auto; border: 4px solid rgb(43, 43, 43); padding: 4px; background-color: var(--content-bg-color); box-shadow: inset 2px 2px 6px rgba(0,0,0,0.3); display: block; margin: 0 auto;">

Week [+ week +] [+ month : month +] [+ year +] 

<span class="wide_tooltip-wrap">Resources available<span class="wide_tooltip-tip"><img src="img/money_2.jpg">Political capital, party funds, and organizational strength to carry out actions for the party</span></span>: [+ resources +]

SLFP position: [? if slfp_in_government = 0 : Opposition ?][? if slfp_in_government = 1 : In government ?]

[? if slfp_in_government and not in_slfp_majority : Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

<span class="wide_tooltip-wrap">Internal dissent<span class="wide_tooltip-tip"><img src="img/logos/SLFP_Logo.png">How severe the bickering between party members has gotten</span></span>: [+ dissent_percent : dissent +]

= Government

[? if state_of_emergency = 1 : <span>**State Of Emergency In Effect**</span> ?]

<span class="wide_tooltip-wrap">President<span class="wide_tooltip-tip">The president is the head of state and head of government in Sri Lanka</span></span>: [+ president +] ([+ president_party +])

[? if slfp_in_government = 1 and (president = "JR Jayawardene" or president = "Ranasinghe Premadasa" ): [+ president +] tensions: [+ president_tension : dissent +] ?]

<span class="wide_tooltip-wrap">Prime Minister<span class="wide_tooltip-tip">The second-highest ranking office in Sri Lanka, after the president and the most senior member of parliament. They can also be the defacto head of government.</span></span>: [+ prime_minister +] ([+ prime_minister_party +])

<span class="wide_tooltip-wrap">Leader of the Opposition<span class="wide_tooltip-tip">Leader of the largest party in parliament, that is not in government</span></span>: [+ opposition_leader +] ([+ opposition_leader_party +])

Current Government: [+ current_gov +]

Parliament composition:

{!<svg id="status_parliament" style="width: 100%; height: 230px; display: block;"></svg>
<script>
(function() {
    if (!d3 || !d3.parliament || !window._parliData || window._parliData.length === 0) return;
    var el = document.getElementById('status_new_parliament');
    if (!el) return;
    var w = el.parentElement.offsetWidth || 220;
    el.setAttribute('width', w);
    el.setAttribute('height', Math.round(w * 0.55));
    var parl = d3.parliament();
    parl.width(w).height(Math.round(w * 0.55)).innerRadiusCoef(0.4);
    var animate = window._parliAnimate;
    parl.enter.fromCenter(animate).smallToBig(animate);
    parl.exit.toCenter(animate).bigToSmall(animate);
    d3.select('#status_new_parliament').datum(window._parliData).call(parl);
})();
</script>!}

[? if slfp_r >= 1 : <span class="tooltip-text" title="Sri Lanka Freedom Party" style="color: #00008B;">**SLFP**</span>: [+ slfp_r +] ?]
