title: Indian General Elections
new-page: true
max-visits: 1
tags: event
view-if: year = 1984 and month = 12 and week = 3
on-arrival: {!
    var _unionData = [];
    function _addLK(id, legend, seats) {
        if (seats && seats > 0) _unionData.push({ id: id, legend: legend, name: legend, seats: seats });
    }
    
    _addLK('inc', 'INC', 404);
    _addLK('indiatdp', 'TDP', 30);
    _addLK('indiacpim', 'CPI(M)', 22);
    _addLK('aiadmk', 'AIADMK', 12);
    _addLK('indiajnp', 'JNP', 10);
    _addLK('indiacpi', 'CPI(M)', 6);  
    _addLK('indiacongresssocialist', 'CongressSocialist', 2);  
    _addLK('indialokdal', 'Lokdal', 3);  
    _addLK('indiarsp', 'RSP', 3);  
    _addLK('indiajknc', 'JKNC', 2);  
    _addLK('indiabjp', 'BJP', 2);  
    _addLK('dmk', 'DMK', 2);
    _addLK('indiaallindiaforward', 'AIFB', 2);  
    _addLK('indiaiuml', 'IUML', 2); 
    _addLK('indiakeralacongress', 'KeralaCongress(J)', 1); 
    _addLK('indiaincj', 'Congress(J)', 1); 
    _addLK('indiapwpi', 'PWPI', 1); 
    _addLK('independent', 'independent', 5);
    _addLK('indiaangloindian', 'Anglo', 2);

    var _unionSig = JSON.stringify(_unionData.map(function(p){ return p.id + p.seats; }));
    window._ussrUnionData = _unionData;
    window._ussrUnionAnimate = (_unionSig !== window._ussrUnionSig);
    if (window._ussrUnionAnimate) window._ussrUnionSig = _unionSig;
!}
on-display: {!
    window.showSceneImage('img/logos/India_Logo.png'); 
    setTimeout(function() {
    if (!d3 || !d3.parliament) return;
    if (window._ussrUnionData && window._ussrUnionData.length > 0) {
        var el1 = document.getElementById('tamil_nadu_diagram');
        if (el1) {
            var w1 = el1.parentElement.offsetWidth || 450;
            var h1 = Math.round(w1 * 0.50);
            el1.setAttribute('width', w1);
            el1.setAttribute('height', h1);
            
            var parl1 = d3.parliament().width(w1).height(h1).innerRadiusCoef(0.4);
            var anim1 = window._ussrUnionAnimate;
            parl1.enter.fromCenter(anim1).smallToBig(anim1);
            parl1.exit.toCenter(anim1).bigToSmall(anim1);
            d3.select('#tamil_nadu_diagram').datum(window._ussrUnionData).call(parl1);
        }
    }
}, 150);
!}

